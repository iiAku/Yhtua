{
  "name": "Yhtua",
  "version": "2.8.2",
  "private": true,
  "description": "Open-source encrypted TOTP token manager for desktop",
  "homepage": "https://iiaku.github.io/Yhtua/",
  "license": "MIT",
  "author": "Yoann Gendrey <yoann@gendrey.fr>",
  "repository": "https://github.com/iiAku/Yhtua",
  "workspaces": [
    "landing",
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "tauri": "tauri",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "nuxi typecheck && bun run --cwd packages/domain typecheck && bun run --cwd apps/mobile typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:version": "bun scripts/check-version.ts",
    "version:bump": "bun scripts/bump-version.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run --cwd landing build && bun run check:version",
    "audit": "bun audit --ignore GHSA-w3rx-r6r6-pgpr --ignore GHSA-5p2g-fcmc-qvqq"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@yhtua/domain": "workspace:*",
    "nuxt": "^4.5.1",
    "otpauth": "^9.5.1",
    "vue": "^3.5.40",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.76.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "@babel/generator": "^7.29.0",
    "@babel/parser": "^7.29.0",
    "@babel/template": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "brace-expansion": "5.0.9",
    "decode-uri-component": "^0.5.0",
    "defu": "^6.1.7",
    "esbuild": "^0.28.1",
    "js-yaml": "^4.3.1",
    "launch-editor": "^2.14.1",
    "lodash": "^4.18.1",
    "minimatch": "^5.1.7",
    "nanoid": "^3.3.18",
    "picomatch": "^2.3.2",
    "postcss": "^8.5.25",
    "postcss-selector-parser": "^7.1.5",
    "rollup": "^4.62.3",
    "sharp": "^0.35.3",
    "shell-quote": "^1.10.0",
    "svgo": "^4.0.2",
    "tar": "^7.5.22",
    "uuid": "^11.1.1",
    "vite": "^8.2.0"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.0"
}
