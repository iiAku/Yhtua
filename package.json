{
  "name": "Yhtua",
  "version": "2.9.0",
  "private": true,
  "description": "Open-source encrypted TOTP token manager for desktop",
  "homepage": "https://iiaku.github.io/Yhtua/",
  "license": "MIT",
  "author": "Yoann Gendrey <yoann@gendrey.fr>",
  "repository": "https://github.com/iiAku/Yhtua",
  "workspaces": [
    "landing",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "tauri": "tauri",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "nuxi typecheck && bun run --cwd packages/domain typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:version": "bun scripts/check-version.ts",
    "version:bump": "bun scripts/bump-version.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run --cwd landing build && bun run check:version",
    "audit": "bun audit --ignore=GHSA-vfj7-8cjw-p6xm --ignore=GHSA-86w9-cpqp-85rv"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@yhtua/domain": "workspace:*",
    "nuxt": "~4.5.2",
    "otpauth": "^9.5.2",
    "vue": "^3.5.43",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.2",
    "lefthook": "^2.1.17",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "@babel/generator": "^7.29.0",
    "@babel/parser": "^7.29.0",
    "@babel/template": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "brace-expansion": "5.0.12",
    "defu": "^6.1.7",
    "esbuild": "^0.28.1",
    "launch-editor": "^2.14.1",
    "lodash": "^4.18.1",
    "minimatch": "^5.1.7",
    "nanoid": "^3.3.18",
    "picomatch": "^2.3.2",
    "postcss": "^8.5.25",
    "rollup": "^4.62.3",
    "sharp": "^0.35.4",
    "shell-quote": "^1.12.0",
    "simple-git": "^4.0.2",
    "svgo": "^4.1.0",
    "tar": "^7.5.22",
    "vite": "^8.2.0"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.3"
}
