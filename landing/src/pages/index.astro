---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import rootPackage from '../../../package.json';

const version = rootPackage.version;
---

<Layout title="Yhtua — Secure 2FA Token Manager">
  <!-- Nav -->
  <nav class="fixed top-0 inset-x-0 z-40 border-b border-border bg-base/80 backdrop-blur-xl backdrop-saturate-150">
    <div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
      <a href="/Yhtua/" class="flex items-center gap-2.5 group" aria-label="Yhtua home">
        <img src="/Yhtua/icon.png" alt="Yhtua" class="w-7 h-7 rounded-lg" />
        <span class="text-sm font-bold tracking-tight text-fg">Yhtua</span>
      </a>
      <div class="hidden sm:flex items-center gap-6">
        <a href="#features" class="text-[13px] text-fg-muted hover:text-fg transition-colors">Features</a>
        <a href="#security" class="text-[13px] text-fg-muted hover:text-fg transition-colors">Security</a>
        <a href="#download" class="text-[13px] text-fg-muted hover:text-fg transition-colors">Download</a>
      </div>
      <a
        href="https://github.com/iiAku/Yhtua/releases/latest"
        class="text-[13px] font-semibold px-4 py-1.5 rounded-lg bg-amber text-base hover:bg-amber-dim transition-colors"
      >
        Download
      </a>
    </div>
  </nav>

  <!-- Hero — split layout with animated TOTP mockup -->
  <section class="relative min-h-screen flex items-center pt-14">
    <!-- Background texture -->
    <div class="absolute inset-0 opacity-30" style="background-image: radial-gradient(rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 32px 32px;"></div>
    <div class="absolute top-1/3 right-0 w-[500px] h-[500px] opacity-100" style="background: radial-gradient(circle, rgba(212,165,74,0.04) 0%, transparent 60%);"></div>

    <div class="relative z-10 max-w-6xl mx-auto px-6 w-full grid lg:grid-cols-2 gap-16 items-center">
      <!-- Left: copy -->
      <div>
        <div class="animate-fade-in">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-emerald/20 bg-emerald-glow mb-8">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald" style="animation: pulse-soft 2s ease-in-out infinite;"></span>
            <span class="text-[13px] font-medium text-emerald">Yhtua {version} — security hardening release</span>
          </div>
        </div>

        <h1 class="animate-fade-in delay-1 text-[clamp(2.25rem,5vw,3.5rem)] font-extrabold tracking-[-0.03em] leading-[1.1] mb-6">
          <span class="text-fg">Two factors.</span><br />
          <span class="bg-gradient-to-r from-amber via-amber-dim to-emerald bg-clip-text text-transparent">Your codes, under your control.</span>
        </h1>

        <p class="animate-fade-in delay-2 text-[17px] text-fg-muted leading-relaxed mb-10 max-w-lg">
          Open-source 2FA token manager with AES-256 encryption and OS keychain integration. No cloud accounts. No tracking.
        </p>

        <div class="animate-fade-in delay-3 flex flex-col sm:flex-row items-start gap-3">
          <a
            href="https://github.com/iiAku/Yhtua/releases/latest"
            class="group inline-flex items-center gap-2.5 px-6 py-3 rounded-xl bg-amber text-base font-semibold text-[15px] hover:bg-amber-dim transition-all shadow-lg shadow-amber/10"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
            Download for free
            <svg class="w-3.5 h-3.5 opacity-50 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
          </a>
          <a
            href="https://github.com/iiAku/Yhtua"
            class="inline-flex items-center gap-2.5 px-6 py-3 rounded-xl border border-border text-fg-muted font-semibold text-[15px] hover:bg-elevated hover:border-border-hover hover:text-fg transition-all"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
            </svg>
            View source
          </a>
        </div>

        <!-- Platform tags -->
        <div class="animate-fade-in delay-4 flex items-center gap-4 mt-8 text-[13px] text-fg-subtle font-medium">
          <span class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M22 17.607c-.786 2.28-3.139 6.317-5.563 6.361-1.608.031-2.125-.953-3.963-.953-1.837 0-2.412.923-3.932.983-2.572.099-6.542-5.827-6.542-10.995 0-4.747 3.308-7.1 6.198-7.143 1.55-.028 3.014 1.045 3.959 1.045.949 0 2.727-1.29 4.596-1.101.782.033 2.979.315 4.389 2.377-3.741 2.442-3.158 7.549.858 9.426zm-5.222-17.607c-2.826.114-5.132 3.079-4.81 5.531 2.612.203 5.118-2.725 4.81-5.531z"/></svg>
            macOS
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M0 12v-8.646l10-1.355v10.001h-10zm11 0h13v-12l-13 1.807v10.193zm-1 1h-10v7.646l10 1.355v-9.001zm1 0v9.194l13 1.806v-11h-13z"/></svg>
            Windows
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.504 0c-.155 0-.315.008-.48.021-4.226.333-3.105 4.807-3.17 6.298-.076 1.092-.3 1.953-1.05 3.02-.885 1.051-2.127 2.75-2.716 4.521-.278.832-.41 1.684-.287 2.489a.424.424 0 0 0-.11.135c-.26.268-.45.6-.663.839-.199.199-.485.267-.797.4-.313.136-.658.269-.864.68-.09.189-.136.394-.132.602 0 .199.027.4.055.536.058.399.116.728.04.97-.249.68-.28 1.145-.106 1.484.174.334.535.47.94.601.81.2 1.91.135 2.774.6.926.466 1.866.67 2.616.47.526-.116.97-.464 1.208-.946.587-.003 1.23-.269 2.26-.334.699-.058 1.574.267 2.577.2.025.134.063.198.114.333l.003.003c.391.778 1.113 1.132 1.884 1.071.771-.06 1.592-.536 2.257-1.306.631-.765 1.683-1.084 2.378-1.503.348-.199.629-.469.649-.853.023-.4-.2-.811-.714-1.376v-.097l-.003-.003c-.17-.2-.25-.535-.338-.926-.085-.401-.182-.786-.492-1.046h-.003c-.059-.054-.123-.067-.188-.135a.357.357 0 0 0-.19-.064c.431-1.278.264-2.55-.173-3.694-.533-1.41-1.465-2.638-2.175-3.483-.796-1.005-1.576-1.957-1.56-3.368.026-2.152.236-6.133-3.544-6.139zm.529 3.405h.013c.213 0 .396.062.584.198.19.135.33.332.438.533.105.259.158.459.166.724 0-.02.006-.04.006-.06v.105a.086.086 0 0 1-.004-.021l-.004-.024a1.807 1.807 0 0 1-.15.706.953.953 0 0 1-.213.335.71.71 0 0 0-.088-.042c-.104-.045-.198-.064-.284-.133a1.312 1.312 0 0 0-.22-.066c.05-.06.146-.133.183-.198.053-.128.082-.264.088-.402v-.02a1.21 1.21 0 0 0-.061-.4c-.045-.134-.101-.2-.183-.333-.084-.066-.167-.132-.267-.132h-.016c-.093 0-.176.03-.262.132a.8.8 0 0 0-.205.334 1.18 1.18 0 0 0-.09.4v.019c.002.089.008.179.02.267-.193-.067-.438-.135-.607-.202a1.635 1.635 0 0 1-.018-.2v-.02a1.772 1.772 0 0 1 .15-.768c.082-.22.232-.406.43-.533a.985.985 0 0 1 .594-.2zm-2.962.059h.036c.142 0 .27.048.399.135.146.129.264.288.344.465.09.199.14.4.153.667v.004c.007.134.006.2-.002.266v.08c-.03.007-.056.018-.083.024-.152.055-.274.135-.393.2.012-.09.013-.18.003-.267v-.015c-.012-.133-.04-.2-.082-.333a.613.613 0 0 0-.166-.267.248.248 0 0 0-.183-.064h-.021c-.071.006-.13.04-.186.132a.552.552 0 0 0-.12.27.944.944 0 0 0-.023.33v.015c.012.135.037.2.08.334.046.134.098.2.166.268.01.009.02.018.034.024-.07.057-.117.07-.176.136a.304.304 0 0 1-.131.068 2.62 2.62 0 0 1-.275-.402 1.772 1.772 0 0 1-.155-.667 1.759 1.759 0 0 1 .08-.668 1.43 1.43 0 0 1 .283-.535c.128-.133.26-.2.418-.2zm1.37 1.706c.332 0 .733.065 1.216.399.293.2.523.269 1.052.468h.003c.255.136.405.266.478.399v-.131a.571.571 0 0 1 .016.47c-.123.31-.516.643-1.063.842v.002c-.268.135-.501.333-.775.465-.276.135-.588.292-1.012.267a1.139 1.139 0 0 1-.448-.067 3.566 3.566 0 0 1-.322-.198c-.195-.135-.363-.332-.612-.465v-.005h-.005c-.4-.246-.616-.512-.686-.71-.07-.268-.005-.47.193-.6.224-.135.38-.271.483-.336.104-.074.143-.102.176-.131h.002v-.003c.169-.202.436-.47.839-.601.139-.036.294-.065.466-.065zm2.8 2.142c.358 1.417 1.196 3.475 1.735 4.473.286.534.855 1.659 1.102 3.024.156-.005.33.018.513.064.646-1.671-.546-3.467-1.089-3.966-.22-.2-.232-.335-.123-.335.59.534 1.365 1.572 1.646 2.757.13.535.16 1.104.021 1.67.067.028.135.06.205.067 1.032.534 1.413.938 1.23 1.537v-.043c-.06-.003-.12 0-.18 0h-.016c.151-.467-.182-.825-1.065-1.224-.915-.4-1.646-.336-1.77.465-.008.043-.013.066-.018.135-.068.023-.139.053-.209.064-.43.268-.662.669-.793 1.187-.13.533-.17 1.156-.205 1.869v.003c-.02.334-.17.838-.319 1.35-1.5 1.072-3.58 1.538-5.348.334a2.645 2.645 0 0 0-.402-.533 1.45 1.45 0 0 0-.275-.333c.182 0 .338-.03.465-.067a.615.615 0 0 0 .314-.334c.108-.267 0-.697-.345-1.163-.345-.467-.931-.995-1.788-1.521-.63-.4-.986-.87-1.15-1.396-.165-.534-.143-1.085-.015-1.645.245-1.07.873-2.11 1.274-2.763.107-.065.037.135-.408.974-.396.751-1.14 2.497-.122 3.854a8.123 8.123 0 0 1 .647-2.876c.564-1.278 1.743-3.504 1.836-5.268.048.036.217.135.289.202.218.133.38.333.59.465.21.201.477.335.876.335.039.003.075.006.11.006.412 0 .73-.134.997-.268.29-.134.52-.334.74-.4h.005c.467-.135.835-.402 1.044-.7zm2.185 8.958c.037.6.343 1.245.882 1.377.588.134 1.434-.333 1.791-.765l.211-.01c.315-.007.577.01.847.268l.003.003c.208.199.305.53.391.876.085.4.154.78.409 1.066.486.527.645.906.636 1.14l.003-.007v.018l-.003-.012c-.015.262-.185.396-.498.595-.63.401-1.746.712-2.457 1.57-.618.737-1.37 1.14-2.036 1.191-.664.053-1.237-.2-1.574-.898l-.005-.003c-.21-.4-.12-1.025.056-1.69.176-.668.428-1.344.463-1.897.037-.714.076-1.335.195-1.814.12-.465.308-.797.641-.984l.045-.022zm-10.814.049h.01c.053 0 .105.005.157.014.376.055.706.333 1.023.752l.91 1.664.003.003c.243.533.754 1.064 1.189 1.637.434.598.77 1.131.729 1.57v.006c-.057.744-.48 1.148-1.125 1.294-.645.135-1.52.002-2.395-.464-.968-.536-2.118-.469-2.857-.602-.369-.066-.61-.2-.723-.4-.11-.2-.113-.602.123-1.23v-.004l.002-.003c.117-.334.03-.752-.027-1.118-.055-.401-.083-.71.043-.94.16-.334.396-.4.69-.533.294-.135.64-.202.915-.47h.002v-.002c.256-.268.445-.601.668-.838.19-.201.38-.336.663-.336zm7.159-9.074c-.435.201-.945.535-1.488.535-.542 0-.97-.267-1.28-.466-.154-.134-.28-.268-.373-.335-.164-.134-.144-.333-.074-.333.109.016.129.134.199.2.096.066.215.2.36.333.292.2.68.467 1.167.467.485 0 1.053-.267 1.398-.466.195-.135.445-.334.648-.467.156-.136.149-.267.279-.267.128.016.034.134-.147.332a8.097 8.097 0 0 1-.69.468zm-1.082-1.583V5.64c-.006-.02.013-.042.029-.05.074-.043.18-.027.26.004.063 0 .16.067.15.135-.006.049-.085.066-.135.066-.055 0-.092-.043-.141-.068-.052-.018-.146-.008-.163-.065zm-.551 0c-.02.058-.113.049-.166.066-.047.025-.086.068-.14.068-.05 0-.13-.02-.136-.068-.01-.066.088-.133.15-.133.08-.031.184-.047.259-.005.019.009.036.03.03.05v.02h.003z"/></svg>
            Linux
          </span>
        </div>
      </div>

      <!-- Right: animated TOTP mockup -->
      <div class="animate-fade-in delay-3 hidden lg:flex justify-center" style="animation: float-slow 8s ease-in-out infinite;">
        <div class="relative">
          <!-- Phone/app frame -->
          <div class="w-[280px] rounded-3xl border border-border bg-surface p-4 shadow-2xl shadow-black/40">
            <!-- Status bar -->
            <div class="flex items-center justify-between mb-6 px-1">
              <span class="text-[10px] font-mono text-fg-subtle">Yhtua</span>
              <div class="flex gap-1">
                <div class="w-1 h-1 rounded-full bg-emerald"></div>
                <span class="text-[10px] font-mono text-emerald">Encrypted</span>
              </div>
            </div>

            <!-- Token card 1 — active with ring -->
            <div class="bg-elevated rounded-2xl p-4 mb-3 border border-amber/10">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-9 h-9 rounded-xl bg-amber-glow-strong flex items-center justify-center">
                  <span class="text-xs font-bold text-amber">GH</span>
                </div>
                <div class="flex-1">
                  <span class="text-[13px] font-semibold text-fg block">GitHub</span>
                  <span class="text-[10px] text-fg-subtle font-mono">6-digit · 30s</span>
                </div>
                <!-- Mini countdown ring -->
                <svg class="w-8 h-8 -rotate-90" viewBox="0 0 36 36">
                  <circle cx="18" cy="18" r="15" fill="none" stroke-width="2" class="stroke-border" />
                  <circle cx="18" cy="18" r="15" fill="none" stroke-width="2" stroke-linecap="round" class="stroke-amber" style="stroke-dasharray: 94.248; animation: ring-countdown 30s linear infinite;" />
                </svg>
              </div>
              <!-- Animated digits -->
              <div class="flex items-center justify-center gap-1.5">
                <span class="totp-digit" style="animation: digit-flip 30s ease-in-out infinite;">4</span>
                <span class="totp-digit" style="animation: digit-flip 30s ease-in-out infinite 0.3s;">8</span>
                <span class="totp-digit" style="animation: digit-flip 30s ease-in-out infinite 0.5s;">3</span>
                <span class="w-2"></span>
                <span class="totp-digit" style="animation: digit-flip 30s ease-in-out infinite 0.7s;">9</span>
                <span class="totp-digit" style="animation: digit-flip 30s ease-in-out infinite 0.9s;">2</span>
                <span class="totp-digit" style="animation: digit-flip 30s ease-in-out infinite 1.1s;">7</span>
              </div>
            </div>

            <!-- Token card 2 — inactive -->
            <div class="bg-elevated rounded-2xl p-3 mb-2 border border-border">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-emerald-glow flex items-center justify-center">
                  <span class="text-[10px] font-bold text-emerald">GL</span>
                </div>
                <span class="text-[13px] font-medium text-fg">GitLab</span>
                <svg class="w-3.5 h-3.5 text-fg-subtle ml-auto" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
              </div>
            </div>

            <!-- Token card 3 — inactive -->
            <div class="bg-elevated rounded-2xl p-3 mb-2 border border-border">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-sky-500/10 flex items-center justify-center">
                  <span class="text-[10px] font-bold text-sky-400">AWS</span>
                </div>
                <span class="text-[13px] font-medium text-fg">AWS Console</span>
                <svg class="w-3.5 h-3.5 text-fg-subtle ml-auto" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
              </div>
            </div>

            <!-- Token card 4 — inactive -->
            <div class="bg-elevated rounded-2xl p-3 border border-border">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-rose-500/10 flex items-center justify-center">
                  <span class="text-[10px] font-bold text-rose-400">GC</span>
                </div>
                <span class="text-[13px] font-medium text-fg">Google Cloud</span>
                <svg class="w-3.5 h-3.5 text-fg-subtle ml-auto" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
              </div>
            </div>
          </div>

          <!-- Glow behind -->
          <div class="absolute -inset-8 -z-10 rounded-3xl opacity-40" style="background: radial-gradient(circle, rgba(212,165,74,0.1) 0%, transparent 70%);"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features — horizontal cards, not grid -->
  <section id="features" class="relative py-28 border-t border-border">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl mb-14 animate-fade-in">
        <p class="text-[13px] font-bold tracking-widest uppercase text-amber mb-3">Features</p>
        <h2 class="text-3xl md:text-[2.5rem] font-extrabold tracking-[-0.02em] leading-[1.1]">
          <span class="text-fg">Everything you need,</span><br />
          <span class="text-fg-muted">nothing you don't.</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-3">
        <div class="group rounded-2xl border border-border bg-surface p-5 hover:bg-elevated hover:border-border-hover transition-all duration-300">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-amber-glow border border-amber/10 flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-5 h-5 text-amber" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
              </svg>
            </div>
            <div>
              <h3 class="text-[15px] font-bold text-fg mb-1">AES-256 Encryption</h3>
              <p class="text-[13px] text-fg-muted leading-relaxed">Every secret encrypted at rest with AES-256-GCM. Keys live in your OS keychain — never on disk in plaintext.</p>
            </div>
          </div>
        </div>

        <div class="group rounded-2xl border border-border bg-surface p-5 hover:bg-elevated hover:border-border-hover transition-all duration-300">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-emerald-glow border border-emerald/10 flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-5 h-5 text-emerald" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0 3 3m-3-3-3 3M6.75 19.5a4.5 4.5 0 0 1-1.41-8.775 5.25 5.25 0 0 1 10.233-2.33 3 3 0 0 1 3.758 3.848A3.752 3.752 0 0 1 18 19.5H6.75Z" />
              </svg>
            </div>
            <div>
              <h3 class="text-[15px] font-bold text-fg mb-1">Cross-Device Sync</h3>
              <p class="text-[13px] text-fg-muted leading-relaxed">Sync via a folder you choose. New backups use Argon2id password derivation and authenticated encryption.</p>
            </div>
          </div>
        </div>

        <div class="group rounded-2xl border border-border bg-surface p-5 hover:bg-elevated hover:border-border-hover transition-all duration-300">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-sky-500/8 border border-sky-500/10 flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-5 h-5 text-sky-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
