{
  "expo": {
    "name": "Yhtua",
    "slug": "yhtua",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yhtua",
    "userInterfaceStyle": "dark",
    "updates": {
      "enabled": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "fr.gendrey.yhtua",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Face ID unlocks your encrypted authenticator tokens.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0b10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Yhtua uses the camera only to scan authenticator QR codes. Nothing is recorded or sent anywhere.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bf4a9317-2b05-425b-ad01-eeec6cb5041d"
      }
    },
    "owner": "iiakuexpo",
    "platforms": ["ios", "web"]
  }
}
